[Unit]
Description=TempMail C++ Backend Server
After=network.target

[Service]
Type=simple
User=tempmail
Group=tempmail
WorkingDirectory=/opt/tempmail/backend
ExecStart=/opt/tempmail/backend/build/tempmail-server --port 3001 --domain example.com
Restart=always
RestartSec=3
Environment=TEMPMAIL_PORT=3001
Environment=TEMPMAIL_DOMAIN=example.com
Environment=TEMPMAIL_DB=/opt/tempmail/backend/data/tempmail.db
LimitNOFILE=65535
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tempmail/backend/data

[Install]
WantedBy=multi-user.target
